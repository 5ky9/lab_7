{
  "name": "agromarket-server",
  "version": "1.0.0",
  "description": "API интернет-магазина АгроМаркет на Express и PostgreSQL",
  "main": "server.js",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "db:init": "node db/seed.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --config vitest.unit.config.js",
    "coverage": "vitest run --coverage",
    "coverage:unit": "vitest run --config vitest.unit.config.js --coverage",
    "db:init:test": "node db/init-test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
